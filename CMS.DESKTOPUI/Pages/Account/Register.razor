@page "/account/register"
@inject IAccountService AccountService
@inject ILawyerService LawyerService
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ISubscriptionService SubscriptionService

@using CMS.DESKTOPUI.CustomAuthentication
@using CMS.Data.ContextModels
@using CMS.Data.FormModels
@using CMS.Services.Interface
@using System.ComponentModel.DataAnnotations

<PageTitle>Register</PageTitle>

<div class="account-pages">
    <!-- Header Section -->
    <div class="row col-12">
        <div class="col-6">
            <div class="col-12 text-center">
                <span class="avatar-title">
                    <h2>CRMS</h2>
                </span>
            </div>
            <div class="mt-3 col-12 text-center">
                <div class="page-title">The simplest case management tool</div>
            </div>
            <div class="my-1 mb-2 col-12 text-center">
                <div class="page-sub-title">Join as Lawyer</div>
            </div>
            <div class="my-1 mb-2 col-12 text-center">
                <div class="p-2 mt-3">
                    <EditForm Model="@model" OnSubmit="OnValidSubmit">
                        <DataAnnotationsValidator />

                        <!-- Use MudGrid for structured layout -->
                        <MudGrid Spacing="2" Class="justify-center">
                            <!-- Left Column -->
                            <MudItem xs="12" sm="6" md="4">
                                <div class="form-group mb-3">
                                    <MudTextField ShrinkLabel @bind-Value="model.Name" Label="Name" Placeholder="Enter name" Variant="Variant.Outlined"
                                                  Required="true" RequiredError="Name is required!" />
                                </div>
                                <div class="form-group my-3">
                                    <MudTextField ShrinkLabel @bind-Value="model.Email" Label="Email" Variant="Variant.Outlined" Placeholder="Enter Email"
                                                  Required="true" RequiredError="Email is required!" Validation="@(new EmailAddressAttribute() { ErrorMessage = "Invalid email address" })" />
                                </div>
                                <div class="form-group my-3">
                                    <MudTextField ShrinkLabel T="string" Variant="Variant.Outlined" @bind-Value="model.Password" Label="Password" InputType="InputType.Password"
                                                  Placeholder="Enter Password" Required="true" RequiredError="Password is required!" />
                                </div>
                                <div class="form-group my-3">
                                    <MudTextField ShrinkLabel Placeholder="Enter Mobile No" Required="true" RequiredError="Mobile no is required!" Immediate="true"
                                                  @bind-Value="model.MobileNo" Mask="@(new PatternMask("(00) 0000-000-000"))" Label="Mobile No" Variant="Variant.Outlined" />
                                </div>
                                <div class="form-group my-3">
                                    <MudTextField ShrinkLabel @bind-Value="model.City" Label="City" Placeholder="Enter City" Variant="Variant.Outlined"
                                                  Required="true" RequiredError="City is required!" />
                                </div>
                                <div class="form-group my-3">
                                    <MudTextField ShrinkLabel T="string" @bind-Value="model.Address" Label="Address" Lines="3" Placeholder="Enter Address"
                                                  Variant="Variant.Outlined" Required="true" RequiredError="Address is required!" />
                                </div>
                                <div class="d-flex justify-content-start mb-3">
                                    <label style="align-content:center;" class="me-2">Gender: </label>
                                    <MudRadioGroup @bind-Value="model.Gender" Required="true">
                                        @foreach (string gender in genderList)
                                        {
                                            <MudRadio Value="@gender" Color="Color.Primary" Size="Size.Medium">@gender</MudRadio>
                                        }
                                    </MudRadioGroup>
                                </div>
                            </MudItem>

                            <!-- Right Column -->
                            <MudItem xs="12" sm="6" md="4">
                                <div class="form-group mb-3">
                                    <MudTextField ShrinkLabel T="string" @bind-Value="model.LawyerFM.AadharNumber" Label="Aadhar Card Number" Placeholder="Enter Aadhar Number"
                                                  Variant="Variant.Outlined" Required="true" RequiredError="Aadhar Number is required!" />
                                </div>
                                <div class="form-group mb-3">
                                    <MudTextField ShrinkLabel T="string" @bind-Value="model.LawyerFM.PanCardNumber" Label="PAN Card Number" Placeholder="Enter PAN Number"
                                                  Variant="Variant.Outlined" Required="true" RequiredError="PAN Number is required!" />
                                </div>
                                <div class="form-group mb-3">
                                    <MudSelect T="string" ShrinkLabel @bind-Value="@specialization" Label="Specialization" Variant="Variant.Outlined"
                                               Required="true" RequiredError="Specialization is required!" Style="text-align:left;">
                                        <MudSelectItem T="string">Select Specialization</MudSelectItem>
                                        @foreach (var item in specializations)
                                        {
                                            <MudSelectItem T="string" Value="@item">@item</MudSelectItem>
                                        }
                                    </MudSelect>
                                </div>
                                <div class="form-group mb-3">
                                    <MudTextField ShrinkLabel T="string" @bind-Value="model.LawyerFM.Lawyer_uniqueNumber" Label="Licence Number" Placeholder="Enter Licence Number"
                                                  Variant="Variant.Outlined" Required="true" RequiredError="Licence Number is required!" />
                                </div>
                                <div class="form-group mb-3">
                                    <MudTextField ShrinkLabel T="string" @bind-Value="model.LawyerFM.VotingId" Label="Voting ID" Placeholder="Enter Voting ID"
                                                  Variant="Variant.Outlined" Required="true" RequiredError="Voting ID is required!" />
                                </div>
                                <div class="form-group mb-3">
                                    <MudDatePicker @bind-Date="model.LawyerFM.DateOfBirth" Label="Date of Birth" Placeholder="Enter Date of Birth"
                                                   Variant="Variant.Outlined" Required="true" RequiredError="Date of Birth is required!" />
                                </div>
                            </MudItem>
                        </MudGrid>

                        <!-- Submit Button and Link -->
                        <div class="form-group text-center col-12 my-3">
                            <MudButton ButtonType="ButtonType.Submit" Disabled="@loading" Color="Color.Primary" Size="Size.Medium" Variant="Variant.Filled" Style="width:25%">
                                @if (loading)
                                {
                                    <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                                }
                                Save
                            </MudButton>
                        </div>
                        <div class="form-group text-center text-dark col-12 my-2">
                            <label class="page-sub-title">
                                Already Have an Account? Please
                                <NavLink href="account/login" class="btn btn-link px-0 page-sub-title" style="text-decoration:none;">Login</NavLink>
                            </label>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
        <div class="col-6">
            <div class="h-90 img-container d-flex align-items-center justify-content-center">
                <img src="svg/login-promo-image.svg" class="img-fluid" />
            </div>
        </div>
    </div>
</div>


@code {
    private User user = new User();
    private RegisterFM model = new RegisterFM();
    private LawyerFM lawyerData = new LawyerFM();
    private List<string> specializations = new List<string>();
    private string specialization = string.Empty;
    private bool loading = false;
    private List<string> genderList = new List<string>() { "Male", "Female", "Other" };

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated ?? false)
        {
            // Redirect to a default page if already authenticated
            NavigationManager.NavigateTo("/");
        }

        model.LawyerFM = new LawyerFM();
        specializations.Add(Specialization.Civil.ToString());
        specializations.Add(Specialization.Criminal.ToString());
        specializations.Add(Specialization.ConsumerProtectionAct.ToString());
        specializations.Add(Specialization.Revenue.ToString());
        specializations.Add(Specialization.LabourContractAct.ToString());

        await base.OnInitializedAsync();
    }

    private async Task OnValidSubmit(EditContext editContext)
    {
        loading = true;
        try
        {
            model.Username = model.Email;
            var userInfo = AccountService.Register(model);
            model.LawyerFM.UserId = userInfo.Id;
            model.LawyerFM.User = userInfo;
            lawyerData = model.LawyerFM;
            var lawyerInfo = LawyerService.CreateOrUpdateLawyer(lawyerData);

            var freeTrialPackage = await SubscriptionService.GetTrialPackageAsync();            // Method to get Free Trial Package
            if (freeTrialPackage != null)
            {
                var subscription = new UserSubscription
                    {
                        UserId = lawyerInfo.Id, // Assuming LawyerService returns the lawyer's ID
                        PackageId = freeTrialPackage.Id,
                        StartDate = DateTime.UtcNow,
                        EndDate = DateTime.UtcNow.AddDays(freeTrialPackage.DurationDays),
                        IsActive = true
                    };
                await SubscriptionService.AssignSubscription(subscription);
            }

            NavigationManager.NavigateTo("account/login");
        }
        catch (Exception ex)
        {
            loading = false;
            StateHasChanged();
        }
    }

}
