@page "/user/profile/{userId:long}"

@using CMS.DESKTOPUI.Pages.Subscription
@using CMS.Data.ContextModels
@using CMS.Data.FormModels
@using CMS.Services
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using CMS.Services.Interface
@using MudBlazor
@* @using Radzen *@

@inject IAccountService AccountService
@inject IUserService UserService
@inject TitleService TitleService
@inject ProtectedSessionStorage Session
@inject ISubscriptionService SubscriptionService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<style>
    .mud-input > input.mud-input-root-outlined{
        padding: 10.5px 14px;
    }

    .mud-input-control{
        background-color: #fff;
    }

    .input-radio {
        background-color: transparent;
    }

    .account-setting-heading-3{
        font-size: 20px;
        font-weight: 700;
        line-height: 24.72px;
        text-align: left;
        color: #041d4d;
    }
</style>

<PageTitle>My Profile</PageTitle>

@if (userData != null)
{
    <EditForm Model="@userData">
        <DataAnnotationsValidator />

        <MudGrid Class="account-setting">
            <MudItem lg="6" sm="12">
                <MudItem Class="ml-lg-9 pl-lg-7 ">
                    <MudGrid>
                        <MudItem sm="12" md="12" Class="mt-3">
                            <MudItem Class="account-setting-heading-3">Account Setting</MudItem>
                        </MudItem>
                    </MudGrid>

                    <MudGrid Class="mt-7">
                        <MudItem md="6" xs="12">
                            <label>Name</label>
                            <MudTextField @bind-Value="@userData.Name"
                                          Placeholder="Enter name"
                                          Variant="Variant.Outlined" />
                        </MudItem>
                        
                        <MudItem md="6" xs="12">
                            <label>Email</label>
                            <MudTextField @bind-Value="@userData.Email"
                                          Placeholder="Enter email"
                                          Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem md="6" xs="12">
                            <label>City</label>
                            <MudTextField @bind-Value="@userData.City"
                                          Placeholder="Enter city"
                                          Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem md="6" xs="12">
                            <label>Mobile</label>
                            <MudTextField @bind-Value="@userData.MobileNo"
                                          Placeholder="Enter Mobile no"
                                          Variant="Variant.Outlined" />
                        </MudItem>

                        <MudItem md="6" xs="12">
                            <label>Role</label>
                            <MudTextField @bind-Value="@userData.Role" Disabled="true"
                                          Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem md="6" xs="12">
                            <label>Gender</label>
                            <MudRadioGroup @bind-Value="userData.Gender" Class="input-radio" Required="true">
                                @foreach (string gender in genderList)
                                {
                                    <MudRadio Value="@gender" Color="Color.Primary" Size="Size.Medium">@gender</MudRadio>
                                }
                            </MudRadioGroup>
                        </MudItem>
                        
                        <MudItem md="12" xs="12">
                            <label>Address</label>
                            <MudTextField Lines="4" @bind-Value="@userData.Address"
                                          Placeholder="Enter company name"
                                          Variant="Variant.Outlined" For="@(() => userData.Address)" />
                        </MudItem>
                    </MudGrid>

                    <MudGrid>
                        <MudItem md="12" Class="mt-7">
                            <MudItem Class="account-setting-heading-3 my-2">Password</MudItem>
                        </MudItem>
                    </MudGrid>

                    <MudGrid>
                        <MudItem md="6" xs="12">
                            <label>Password</label>
                            <MudTextField @bind-Value="@userData.Password" For="@(() => userData.Password)"
                                          InputType="@InputType.Password"
                                          Placeholder="Old password"
                                          Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem md="6" xs="12">
                            <AuthorizeView Roles="Lawyer">
                                <Authorized Context="authorizedContext">
                                    <label>Subscription</label>
                                    @if (!hasSubscription)
                                    {
                                        <MudButton Color="Color.Primary" @onclick="@(() => AddSubscription(userData.Id))" 
                                                   Class="mx-1" ButtonType="ButtonType.Submit" Variant="Variant.Filled">
                                            Add Subscription
                                        </MudButton>
                                    }
                                    else
                                    {
                                        <MudItem class="profile-field">
                                            <label><strong>Subscription End Date:</strong></label>
                                            <span>@userSubscription.EndDate.ToString("yyyy-MM-dd")</span>
                                        </MudItem>
                                    }
                                </Authorized>
                            </AuthorizeView>
                        </MudItem>
                    </MudGrid>
                    <MudGrid>
                        <AuthorizeView Roles="Lawyer">
                            <Authorized Context="authorizedContext">
                                <MudItem md="6" xs="12" Class="mt-4">
                                    <MudButton Color="Color.Primary" Class="mx-1" Href="@($"subscription/paymentDetails/{userId}")" ButtonType="ButtonType.Submit" Variant="Variant.Filled">Payment Details</MudButton>
                                </MudItem>
                            </Authorized>
                        </AuthorizeView>
                        <MudItem md="6" xs="12" Class="mt-4">
                            <MudButton Color="Color.Primary" Class="mx-1" ButtonType="ButtonType.Submit" Variant="Variant.Filled" OnClick="SaveChanges">Save Changes</MudButton>
                        </MudItem>
                    </MudGrid>
                </MudItem>
            </MudItem>
        </MudGrid>
    </EditForm>
}
else
{
    <label style="font-size:18px;color:#041D4D;font-weight:600">User account not found.</label>
}

@code {
    [Parameter] public long userId { get; set; }
    private User userData = new User();
    private UserFM userFM = new UserFM();
    private List<string> genderList = new List<string>() { "Male", "Female", "Other" };
    private bool hasSubscription;
    private UserSubscription userSubscription = new UserSubscription();

    protected override async Task OnInitializedAsync()
    {
        TitleService.CurrentPageTitle = "Profile";
        var userSessionId = await Session.GetAsync<long>("UserId");
        userId = userSessionId.Value > 0 ? userSessionId.Value : 0;

        userData = UserService.GetUserById(userId);

        await base.OnInitializedAsync();

        hasSubscription = SubscriptionService.HasSubscription(userId);
        if (hasSubscription)
        {
            userSubscription = SubscriptionService.GetUserSubscriptionById(userId);

            if (userSubscription != null && userSubscription.EndDate < DateTime.Now)
            {
                // Remove the subscription
                SubscriptionService.RemoveSubscription(userSubscription.Id);
            }
        }
    }

    private async Task SaveChanges()
    {
        try
        {
            if (userData == null)
            {
                Snackbar.Add("User data is missing. Please reload the page.", Severity.Error);
                return;
            }

            var userFM = new UserFM
                {
                    Id = userData.Id,
                    Name = userData.Name,
                    EmailId = userData.Email,
                    City = userData.City,
                    MobileNo = userData.MobileNo,
                    Role = userData.Role,
                    Gender = userData.Gender,
                    Address = userData.Address,
                    Password = userData.Password,
                    Username = userData.Username
                };
            var isUpdated =  UserService.CreateOrUpdateUser(userFM);

            if (isUpdated != null)
            {
                Snackbar.Add("User details updated successfully.", Severity.Success);

                // Optionally refresh the user data to reflect any server-side changes
                userData = UserService.GetUserById(userId);
            }
            else
            {
                Snackbar.Add("Failed to update user details. Please try again.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            // General exception handling
            Snackbar.Add($"An error occurred: {ex.Message}", Severity.Error);
        }
    }

    private Task AddSubscription(long userId)
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium, };

        return DialogService.ShowAsync<SubscriptionPrompt>("Simple Dialog", options);
    }
}