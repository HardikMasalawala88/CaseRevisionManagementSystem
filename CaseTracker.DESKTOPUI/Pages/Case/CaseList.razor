@page "/case/caselist"
@attribute [Authorize(Roles ="Lawyer")]

@using CaseTracker.DESKTOPUI.Shared.Component
@using CaseTracker.Data.ContextModels
@using CaseTracker.Data.Enum
@using CaseTracker.Data.ParameterModels
@using CaseTracker.Services
@using CaseTracker.Services.Interface
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage

@inject ICaseService CaseService
@inject TitleService TitleService
@inject NavigationManager NavigationManager
@inject IJSRuntime Js
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject ProtectedSessionStorage Session
@inject ISubscriptionService SubscriptionService

@if (caseList == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="col-12 d-flex justify-content-between mt-3">
        <div class="d-flex justify-content-start">
            <MudButton Disabled="preventAction" Class="m-2" OnClick="@(() => DeleteConfirm())" Variant="Variant.Filled" Size="Size.Small"> Delete </MudButton>
            <MudButton OnClick=@(args => AddCase("/case/add")) StartIcon="@Icons.Material.Filled.Add" Color="Color.Primary" Variant="Variant.Filled" Class="m-2" Size="Size.Medium">Add Case</MudButton>
            <MudButton Disabled="!hasSubscription" OnClick="@(async args => await PrintCaseList())" Class="m-2" Color="Color.Primary" Variant="Variant.Filled">Print</MudButton>
        </div>
        <div class="my-2 d-flex justify-content-end">
            <label style="align-content:center;">From Date:</label><MudDatePicker @bind-Date="@fromDate" DateFormat="dd/MM/yyyy" Class="mx-2" />
            <label style="align-content:center;">To Date:</label><MudDatePicker @bind-Date="@toDate" DateFormat="dd/MM/yyyy" Class="mx-2" />

            <MudButton Class="me-3" OnClick="@(args => FilterCases())" Color="Color.Primary" Variant="Variant.Filled">Search</MudButton>
            <MudButton Class="me-3" OnClick="@(args => Clear())" Variant="Variant.Outlined" Color="Color.Primary"><MudIcon Icon="@Icons.Material.Filled.Close" Color="Color.Primary"/></MudButton>
        </div>
    </div>

    <div class="main-table mt-3">
        <MudDataGrid @ref="_dataGrid" T="Case" Class="case-table" MultiSelection="true" ServerData="@(LoadGridData)"
                     SortMode="SortMode.Single" Filterable="false" Loading="showDataGridLoader"
                     Hideable="false" FooterClass="d-none" Hover="@true" SelectedItemsChanged="@(() => PreventAction())">
            <Columns>
                <SelectColumn T="Case" />
                <TemplateColumn CellClass="bold-cell" Filterable="false" Title="Client Name" Sortable="false">
                    <CellTemplate>
                        <MudStack Class="mustack-gap">
                            <MudText Class="user-name">
                                @if (context.Item.Client != null && context.Item.Client.User != null)
                                {
                                    @(context.Item.Client.User.Name)
                                }
                                else
                                {
                                    @("-")
                                }
                            </MudText>
                        </MudStack>
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn CellClass="bold-cell" Property="x => x.CaseTitle" Sortable="false" Title="Title" />
                <PropertyColumn CellClass="bold-cell" Property="x => x.CaseDetail" Sortable="false" Title="Detail" />
                <PropertyColumn CellClass="bold-cell" Property="x => x.HearingDate" Sortable="false" Title="Hearing Date" />
                <PropertyColumn CellClass="bold-cell" Property="x => x.CourtLocation" Sortable="false" Title="Court Location" />
                <PropertyColumn CellClass="bold-cell" Property="x => x.CaseNumber" Sortable="false" Title="Case Number" />
                <TemplateColumn CellClass="" Filterable="false" Title="Action" Sortable="false">
                    <CellTemplate>
                        <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" IconColor="Color.Secondary"
                                 Dense="true" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopCenter">
                            <MudMenuItem OnClick="@(e => EditCase(@context.Item.Id))">Edit</MudMenuItem>
                            <MudMenuItem OnClick="@(e => DeleteConfirm(@context.Item))">Delete</MudMenuItem>
                        </MudMenu>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <PagerContent>
                <MudDataGridPager T="Case" InfoFormat="Showing {first_item}-{last_item} of {all_items}" />
            </PagerContent>
        </MudDataGrid>
    </div>
}

@code {
    private List<Case> caseList = new();
    private List<Case> searchCaseData = new();
    private Case caseData = new();
    private DateTime? fromDate;
    private DateTime? toDate;
    private bool showDataGridLoader;
    private MudDataGrid<Case> _dataGrid;
    DateTime date = DateTime.Now;
    private string sortField = "";
    private bool preventAction = true;
    private EnumListSortDirection sortOrder = EnumListSortDirection.Ascending;
    private bool hasSubscription;
    [Parameter] public long userId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        TitleService.CurrentPageTitle = "Cases";
        GetCase();
        fromDate = new DateTime(date.Year, date.Month, 1);
        toDate = fromDate.Value.AddMonths(1).AddDays(-1);

        var userSessionId = await Session.GetAsync<long>("UserId");
        userId = userSessionId.Value > 0 ? userSessionId.Value : 0;
        hasSubscription = SubscriptionService.HasSubscription(userId);

        await base.OnInitializedAsync();
    }

    private void GetCase()
    {
        caseList = CaseService.ListCaseDetail();
        searchCaseData = caseList;
    }

    private async Task AddCase(string redirectUrl)
    {
        DialogParameters dialogParameters = new DialogParameters();
        dialogParameters.Add("FormAction", FormAction.Add);

        var caseInfo = await DialogService.ShowAsync<AddEditCase>("Add Case", dialogParameters, new DialogOptions()
        {
            MaxWidth = MaxWidth.Medium,
            Position = DialogPosition.Center,
            CloseButton = true,
            FullWidth = true
        });

        var res = await caseInfo.Result;

        if (!res.Canceled)
        {
            Snackbar.Add("Case saved successfully.", Severity.Success);
            await ReloadGrid();
        }
    }

    private async Task Clear()
    {
        fromDate = new DateTime(date.Year, date.Month, 1);
        toDate = fromDate.Value.AddMonths(1).AddDays(-1);
        await ReloadGrid();
    }

    private async Task<GridData<Case>> LoadGridData(GridState<Case> state)
    {
        GridData<Case> gridData = new();

        foreach (var sortDefinition in state.SortDefinitions)
        {
            sortField = sortDefinition.SortBy;
            sortOrder = sortDefinition.Descending ? EnumListSortDirection.Descending : EnumListSortDirection.Ascending;
        }

        showDataGridLoader = true;
        var getLeadsParameters = new GetCaseParameters(state.Page + 1, state.PageSize, sortField, sortOrder, fromDate, toDate);
        var data = await CaseService.GetCaseAsync(getLeadsParameters);

        if (data != null && data.Success && data.Result != null)
        {
            gridData = new()
            {
                Items = data.Result.Data,
                TotalItems = data.Result.TotalCount
            };
        }
        else
        {
            Snackbar.Add("Error while getting Case.", Severity.Error);
        }

        showDataGridLoader = false;
        return gridData;
    }

    private async Task EditCase(long caseId)
    {
        DialogParameters dialogParameters = new DialogParameters();
        dialogParameters.Add("CaseId", caseId);
        dialogParameters.Add("FormAction", FormAction.Edit);

        var caseInfo = await DialogService.ShowAsync<AddEditCase>("Edit Case", dialogParameters, new DialogOptions()
            {
                MaxWidth = MaxWidth.Medium,
                Position = DialogPosition.Center,
                CloseButton = true,
                FullWidth = true
            });

        var res = await caseInfo.Result;

        if (!res.Canceled)
        {
            //Snackbar.Add("Case saved successfully.", Severity.Success);
            await ReloadGrid();
        }
    }

    private void PreventAction()
    {
        StateHasChanged();
        preventAction = !_dataGrid.SelectedItems.Any();
    }

    private async Task PrintCaseList()
    {
        await Js.InvokeVoidAsync("printTable");
    }

    protected async Task FilterCases()
    {
        if (fromDate.HasValue && toDate.HasValue)
        {
            await ReloadGrid();
        }
    }

    protected async Task DeleteConfirm(Case caseFM = null)
    {
        var options = new DialogOptions { CloseButton = true };
        var parameters = new DialogParameters();

        if (caseFM != null)
        {
            _dataGrid.SelectedItems.Add(caseFM);
        }

        if (_dataGrid.SelectedItems.Count() == 0)
        {
            parameters.Add("DialogContent", $"Please select case to delete.");
            parameters.Add("CancelButtonText", "OK");
            parameters.Add("ShowConfirmButton", false);
        }
        else if (_dataGrid.SelectedItems.Count() > 0)
        {
            parameters.Add("DialogContent", $"This action cannot be undo.");
        }

        var dialog = DialogService.Show<ConfirmationDialog>("Confirm delete request", parameters);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            //Delete all selected record
            var data = CaseService.BulkDeleteCase(_dataGrid.SelectedItems.Select(x => x.Id).ToList());
            if (data.Success && data.Result)
            {
                Snackbar.Add("Case deleted successfully", MudBlazor.Severity.Success);
            }
            else
            {
                Snackbar.Add("There was an error encountered while attempting to delete the case.", MudBlazor.Severity.Error);
            }

            await ReloadGrid();
        }
    }

    private async Task ReloadGrid()
    {
        if (_dataGrid != null)
        {
            _dataGrid.SelectedItems.Clear();
            PreventAction();
            await _dataGrid!.ReloadServerData();
            PreventAction();
            await InvokeAsync(StateHasChanged);
        }
    }
}