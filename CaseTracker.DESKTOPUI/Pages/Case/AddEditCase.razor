@page "/case/add"
@page "/case/edit/{CaseId:long}"

@using CaseTracker.DESKTOPUI.Pages.Client
@using CaseTracker.Data.ContextModels
@using CaseTracker.Data.Enum
@using CaseTracker.Data.FormModels
@using CaseTracker.Repository.Interface
@using CaseTracker.Services.Interface
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage

@inject ICaseService CaseService
@inject IClientService ClientService
@inject ILawyerService LawyerService
@inject NavigationManager NavigationManager
@inject ProtectedSessionStorage Session
@inject IUserRepository UserRepository
@inject IWebHostEnvironment WebEnvironment
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudGrid Class="p-3">
    <MudItem xs="12">
        <EditForm Model="@model" OnValidSubmit="OnValidSubmit">
            <MudStack Spacing="2">
                <!-- Case Title and Select Client -->
                <MudGrid>
                    <MudItem xs="12" md="6">
                        <MudTextField Label="Case Title" Variant="Variant.Outlined" @bind-Value="model.CaseTitle" Required="true" />
                    </MudItem>
                   @*  <MudItem xs="12" md="6">
                        <MudSelect T="string" Label="Select Client" Variant="Variant.Outlined" Value="selectedClient" Required="true" ValueChanged="@((e) => OnClientChange(e))">
                            <MudSelectItem T="string" Value="null" Disabled="true">-- Select Client --</MudSelectItem>
                            @foreach (var client in clientList)
                            {
                                <MudSelectItem T="string" Value="@client">@client</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem> *@
                    <MudItem xs="12" md="6">
                        <MudAutocomplete T="string"
                                         Label="Select Client"
                                         Variant="Variant.Outlined"
                                         Value="@selectedClient"
                                         SearchFunc="SearchClients"
                                         ValueChanged="OnClientChange"
                                         Placeholder="Type to search clients..."
                                         Clearable="true"
                                         Required="true"
                                         ToStringFunc="@(client => client)" />

                        @* <MudAutocomplete T="string" Label="Select Client" @bind-Value="selectedClient" SearchFunc=""
                                         Variant="Variant.Outlined" ValueChanged="OnClientChange" Placeholder="Type to search..." Clearable="true" Required="true" /> *@


              @*           @if (showAddClientButton)
                        {
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="OpenAddClientDialog">
                                Add Client
                            </MudButton>
                        } *@
                    </MudItem>
                </MudGrid>

                <!-- Hearing Date and Court Location -->
                <MudGrid>
                    <MudItem xs="12" md="6">
                        <MudDatePicker Label="Hearing Date" Variant="Variant.Outlined" @bind-Date="value" Required="true" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudTextField Label="Court Location" Variant="Variant.Outlined" @bind-Value="model.CourtLocation" Required="true" />
                    </MudItem>
                </MudGrid>

                <!-- Case Number and Parent Case Number -->
                <MudGrid>
                    <MudItem xs="12" md="6">
                        <MudTextField Label="Case Number" Variant="Variant.Outlined" @bind-Value="model.CaseNumber" Required="true" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        @* @bind-Value="selectedCaseParentId" *@
                        <MudSelect T="string" Label="Parent Case No" Variant="Variant.Outlined" 
                        Value="@selectedCaseParentId" 
                        ValueChanged="@((string updatedValue) => OnCaseNumberChange(updatedValue))">
                            <MudSelectItem T="string" Value="null" Disabled="true">-- Select Case --</MudSelectItem>
                            @foreach (var caseItem in cases)
                            {
                                <MudSelectItem T="string" Value="@caseItem.CaseNumber">@caseItem.CaseNumber (@caseItem.HearingDate.ToShortDateString())</MudSelectItem>
                            }
                        </MudSelect>
                      @*   <MudAutocomplete T="string"
                                         Label="Parent Case No"
                                         Variant="Variant.Outlined"
                                         Value="@selectedCaseParentId"
                                         SearchFunc="SearchCases"
                                         ValueChanged="OnCaseNumberChange"
                                         Placeholder="Type to search Cases..."
                                         Clearable="true">
                            @caseItem.CaseNumber (@caseItem.HearingDate.ToShortDateString())
                                    </MudAutocomplete> *@
                    </MudItem>
                </MudGrid>

                <!-- Case Documents -->
                @if(FormAction == FormAction.Edit)
                {
                    <MudGrid>
                        <MudItem xs="12">
                            <MudPaper Outlined="true" Class="p-2">
                                <MudText Typo="Typo.subtitle2">Case Documents</MudText>
                                <MudFileUpload T="IBrowserFile" Accept=".pdf,.docx,.png,.jpg,.jpeg" FilesChanged="SelectFiles" MaximumFileCount="10">
                                    <ActivatorContent>
                                        <MudButton Variant="Variant.Filled"
                                                   Color="Color.Primary"
                                                   StartIcon="@Icons.Material.Filled.CloudUpload">
                                            Upload files
                                        </MudButton>
                                    </ActivatorContent>
                                </MudFileUpload>
                                @(files.Count > 0 ? $"Selected Files Count: {files.Count}" : "")
                                @* <MudFileUpload T="IBrowserFile" Accept=".pdf,.docx,.png,.jpg,.jpeg" FilesChanged="SelectFiles" /> *@
                            </MudPaper>
                        </MudItem>
                    </MudGrid>
                }

                <!-- Case Detail -->
                <MudTextField Label="Case Detail" Variant="Variant.Outlined" @bind-Value="model.CaseDetail" Required="true" Lines="4" />
            </MudStack>

            <!-- Actions -->
            <div class="d-flex justify-content-end mt-2">
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">Save</MudButton>
                <MudButton Variant="Variant.Filled" Class="mx-2" Color="Color.Secondary" OnClick="@(() => MudDialog.Close())">Close</MudButton>
            </div>

            @if (CaseId > 0)
            {
                var currentCase = cases.FirstOrDefault(c => c.Id == CaseId);
                @if(currentCase != null)
                {
                    var filteredCases = cases.Where(c => c.Title != currentCase.CaseTitle).ToList();
                    <div class="parent-caselist">
                        <h4>Parent Case Details</h4>
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Case ID</th>
                                    <th>Case Title</th>
                                    <th>Hearing Date</th>
                                    <th>Case Number</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var caseItem in filteredCases)
                                {
                                    <tr>
                                        <td>@caseItem.Id</td>
                                        <td>@caseItem.Title</td>
                                        <td>@caseItem.HearingDate.ToShortDateString()</td>
                                        <td>@caseItem.CaseNumber</td>
                                        <td><MudButton Variant="Variant.Text" Color="Color.Primary" 
                                            OnClick="@(e => ViewCase(caseItem.Id))">View</MudButton></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p>No case found with the given ID.</p>
                }
            }
        </EditForm>
    </MudItem>
</MudGrid>


@if (caseDocuments is not null && caseDocuments.Any())
{
    <div class="ma-3">
        <h3>Case Documents:</h3>
    </div>
    <MudDivider />
    <div class="mx-3">
        @foreach (var fileData in caseDocuments)
        {
            if (ImageExtensions.Contains(Path.GetExtension(fileData.FileName).ToUpperInvariant()))
            {
                <span style="cursor:pointer;" @onclick="@(() => openImgDocument(Path.Combine(fileData.Url,fileData.FileName)))">
                    @fileData.FileName
                </span>
                <hr />
            }

            if (Path.GetExtension(fileData.FileName).ToUpperInvariant().Equals(".PDF"))
            {
                <span style="cursor:pointer;" @onclick="@(() => openPdfDocument(fileData.Url))">
                    @fileData.FileName
                </span>
                <hr />
            }

            if (DocExtensions.Contains(Path.GetExtension(fileData.FileName).ToUpperInvariant()))
            {
                <a href="#" download="@fileData.FileName" target="_top">
                    @fileData.FileName
                </a>
                <hr />
            }
        }
    </div>
}


@code
{
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; }

    [Parameter]
    public long CaseId { get; set; }

    [Parameter]
    public EnumFormAction FormAction { get; set; }

    [Parameter]
    public DateTime HearingDate { get; set; }

    [Parameter]
    public CaseFM Case { get; set; }

    ProtectedBrowserStorageResult<string> userName = new ProtectedBrowserStorageResult<string>();
    private string title = string.Empty;
    DateTime? value = DateTime.Now;
    private string searchText = "";
    private string searchCaseNumber = "";
    private CaseFM model = new CaseFM();
    private string selectedClient = string.Empty;
    private string selectedCaseParentId = string.Empty;
    private List<CaseDocument> caseDocuments = new List<CaseDocument>();
    private List<Case> cases;
    private User userData = new User();
    private Lawyer lawyerData = new Lawyer();
    private List<Client> clients = new List<Client>();
    private Client clientInfo = new Client();
    private List<string> clientList = new List<string>();
    IList<IBrowserFile> files = new List<IBrowserFile>();
    private int maxFileSize = 1 * 1024 * 1024;
    // RadzenUpload uploadFile;
    public static readonly List<string> ImageExtensions = new List<string> { ".JPG", ".JPEG", ".JPE", ".BMP", ".GIF", ".PNG" };
    public static readonly List<string> DocExtensions = new List<string> { ".DOC", ".DOCX", ".CSV", ".XLS" };
    private bool showAddClientButton = false;

    protected override async Task OnInitializedAsync()
    {
        cases = CaseService.ListCaseDetail();

        if (CaseId > 0 || Case is not null)
        {
            title = "Edit Case";
            model = CaseService.GetCaseById(CaseId);
            var caseData = cases.FirstOrDefault(c => c.Id == model.CaseParentId);
            if (model is not null && model.Id > 0)
            {
                selectedClient = ClientService.GetClientById(model.ClientId).User.Email;
                clientInfo = ClientService.GetClientUsingEmail(selectedClient);
                selectedCaseParentId = caseData != null ? caseData.CaseNumber : string.Empty;
                value = model.HearingDate;
            }
            else
            {
                selectedClient = ClientService.GetClientById(Case.ClientId).User.Email;
                clientInfo = ClientService.GetClientUsingEmail(selectedClient);
                selectedCaseParentId = caseData != null ? caseData.CaseNumber : string.Empty;
                value = Case.HearingDate;
            }

            caseDocuments = CaseService.ListCaseDocDetail();
        }
        else
        {
            title = "Add Case";
        }

        userName = await Session.GetAsync<string>("User");
        userData = UserRepository.GetLoggedInUser(userName.Value);
        lawyerData = LawyerService.GetLawyerDataByUserId(userData.Id);
        clients = ClientService.GetClientsUsingLawyerId(userData.Username);
        clientList = clients.Select(x => x.User.Email).Distinct().ToList();

        base.OnInitialized();
    }

    private async Task<IEnumerable<string>> SearchClients(string value, CancellationToken token)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            showAddClientButton = false;
            return clientList; // Return full list if no input
        }

        var filteredClients = clientList
            .Where(c => c.Contains(value, StringComparison.OrdinalIgnoreCase))
            .ToList();

        if (!filteredClients.Any())
        {
            showAddClientButton = true;
            return new List<string> { $"No client found '{value}' Click here to Add Client" }; // Add Client option
        }

        showAddClientButton = false;

        return await Task.FromResult(filteredClients); // Ensure it returns a Task
    }

    private async Task<IEnumerable<string>> SearchCases(string value, CancellationToken token)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return cases.Select(c => c.CaseNumber).ToList(); // Return all cases if no input
        }

        var filteredCases = cases
            .Where(c => c.CaseNumber.Contains(value, StringComparison.OrdinalIgnoreCase))
            .Select(c => $"{c.CaseNumber} ({c.HearingDate.ToShortDateString()})")
            .ToList();

        return await Task.FromResult(filteredCases);
    }

    private void OnClientChange(object clientEmail)
    {
        if (clientEmail != null && clientEmail.ToString().EndsWith("Click here to Add Client"))
        {
            OpenAddClientDialog();
            return;
        }
        selectedClient = clientEmail.ToString();
        showAddClientButton = false;
        if (clientEmail is not null && !string.IsNullOrEmpty(clientEmail.ToString()))
        {
            clientInfo = ClientService.GetClientUsingEmail(clientEmail.ToString());
        }
    }

    private async Task OpenAddClientDialog()
    {
        DialogParameters dialogParameters = new DialogParameters();
        dialogParameters.Add("FormAction", FormAction.Add);

        var options = new DialogOptions { CloseOnEscapeKey = true, CloseButton = true, Position = DialogPosition.Center, MaxWidth = MaxWidth.Medium, FullWidth = true };

        var data = DialogService.Show<AddEditClient>("Add Client", dialogParameters, options);
        var result = await data.Result;

        if (!result.Canceled)
        {
            // Show a success message when the dialog is closed
            // Snackbar.Add("Client saved successfully.", Severity.Success);
            clients = ClientService.GetClientsUsingLawyerId(userData.Username);
            await InvokeAsync(() => StateHasChanged());
        }
    }

    private async Task ViewCase(long caseId)
    {
        DialogParameters dialogParameters = new DialogParameters();
        dialogParameters.Add("CaseId", caseId);
        dialogParameters.Add("FormAction", FormAction.View);

        await DialogService.ShowAsync<CaseDetail>("Case Detail", dialogParameters, new DialogOptions()
            {
                MaxWidth = MaxWidth.Medium,
                Position = DialogPosition.Center,
                CloseButton = true,
                FullWidth = false
            });
    }

    private void OnCaseNumberChange(object caseNumber)
    {
        if (caseNumber is not null)
        {
            selectedCaseParentId = Convert.ToString(caseNumber);
            model.CaseParentId = cases.First(c => c.CaseNumber == selectedCaseParentId).Id;

        }
        else
        {
            model.CaseParentId = 0;
            if (Case != null)
                Case.CaseParentId = 0;
        }
    }

    protected override void OnParametersSet()
    {
        model.HearingDate = HearingDate;
        if (Case is not null)
        {
            model = Case;
        }
    }

    private async Task OnValidSubmit()
    {
        try
        {
            if (CaseId > 0)
            {
                foreach (var file in files)
                {
                    try
                    {
                        var uploadPath = Path.Combine(Directory.GetCurrentDirectory(), "wwwroot", "uploads");

                        if (!Directory.Exists(uploadPath))
                        {
                            Directory.CreateDirectory(uploadPath);
                        }

                        var filePath = Path.Combine(uploadPath, file.Name);

                        var fileStream = new FileStream(filePath, FileMode.Create);
                        IFormFile formFile = new FormFile(fileStream, 0, fileStream.Length, file.Name, file.Name);

                        // Save the file
                        // using (var stream = new FileStream(filePath, FileMode.Create))
                        // {
                        //     await formFile.CopyToAsync(stream);
                        // }

                        CaseDocumentFM caseDocument = new CaseDocumentFM();
                        caseDocument.FileName = file.Name;
                        caseDocument.CaseId = CaseId;
                        caseDocument.Url = uploadPath;

                        CaseService.CreateOrUpdateCaseDocument(caseDocument);
                    }
                    catch (Exception ex)
                    {
                        Snackbar.Add(ex.Message, Severity.Error);
                    }
                }
            }

            model.Client = clients.FirstOrDefault(x => x.Id == clientInfo.Id);
            model.ClientId = clientInfo.Id;
            model.HearingDate = value.Value;
            model.Lawyer = lawyerData;
            model.LawyerId = lawyerData.Id;

            var caseInfo = CaseService.CreateOrUpdateCase(model);
            Snackbar.Add("Case saved Successfully!", Severity.Success);
            MudDialog.Close(DialogResult.Ok(caseInfo));

        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private void SelectFiles(IBrowserFile file)
    {
        files.Add(file);
    }

    private void openImgDocument(string url)
    {
        var index = url.Contains("UploadedFiles") ? url.LastIndexOf("UploadedFiles") : 0;
        var path = url.Substring(index);
    //     DialogService.Show("Case document", ds =>
    // @<div style="display: flex;justify-content: space-between;align-items: end; height: fit-content;">
    //     <img Path="@(path)" />
    // </div>);
    }

    private void openPdfDocument(string url)
    {
        var index = url.Contains("UploadedFiles") ? url.LastIndexOf("UploadedFiles") : 0;
        var path = url.Substring(index);
    //     DialogService.Show("Case document", ds =>
    // @<div style="display: flex;justify-content: space-between;align-items: end; height: fit-content;">
    //     <iframe src="@path" style="width:750px;height:750px;" type="application/pdf" />
    // </div>
        // );
    }
}

