@page "/case/clientcases"
@attribute [Authorize(Roles = "Client")]

@using CaseTracker.DESKTOPUI.Pages.Case
@using CaseTracker.Data.ContextModels
@using CaseTracker.Data.Enum
@using CaseTracker.Services
@using CaseTracker.Services.Interface
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage

@inject ICaseService CaseService
@inject IClientService ClientService
@inject IUserService UserService
@inject NavigationManager NavigationManager
@inject IJSRuntime Js
@inject TitleService TitleService
@inject DialogService DialogService
@inject ProtectedSessionStorage Session
@inject ISnackbar Snackbar

<h3 class="title">@(string.Concat(userName, " Case details!"))</h3>

@if (caseList == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="mt-3 d-flex justify-content-between col-12">
        <div class="d-flex justify-content-start">
            <MudButton OnClick=@(args => AddCase("/case/add")) StartIcon="@Icons.Material.Filled.Add" Color="Color.Primary" Variant="Variant.Filled" Class="m-2" Size="Size.Medium">Add Case</MudButton>
            <MudButton OnClick="PrintCaseList" Class="m-2" Variant="Variant.Filled" Color="Color.Primary">Print</MudButton>
        </div>
        <!-- Filter Section -->
        <div class="my-2 d-flex justify-content-end">
            @* <MudStack AlignItems="AlignItems.Center" Spacing="3" Wrap="Wrap.Wrap"> *@
                <label style="align-content:center;">From Date:</label><MudDatePicker @bind-Value="@fromDate" DateFormat="dd/MM/yyyy" Class="mx-2" />
                <label style="align-content:center;">To Date:</label><MudDatePicker @bind-Value="@toDate" DateFormat="dd/MM/yyyy" Class="mx-2" />

            <MudButton OnClick="FilterCases" Class="me-3" Variant="Variant.Filled" Color="Color.Primary">Search</MudButton>
            @* </MudStack> *@
        </div>
    </div>

    <!-- Table Section -->
    <div class="main-table mt-3">
        <MudDataGrid T="Case" Items="caseList" Class="case-table" Dense="true" Hover="true" Bordered="true"
                     SortMode="SortMode.Single" Filterable="false" Hideable="false" FooterClass="d-none">
            <Columns>
                <SelectColumn T="Case" />
                <PropertyColumn CellClass="bold-cell" Property="x => x.CaseTitle" Sortable="false" Title="Case Title" />
                <PropertyColumn CellClass="bold-cell" Property="x => x.CaseDetail" Sortable="false" Title="Case Detail" />
                <PropertyColumn CellClass="bold-cell" Property="x => x.HearingDate" Sortable="false" Title="Hearing Date" />
                <PropertyColumn CellClass="bold-cell" Property="x => x.CourtLocation" Sortable="false" Title="Court Location" />
                <PropertyColumn CellClass="bold-cell" Property="x => x.CaseNumber" Sortable="false" Title="Case Number" />
            </Columns>
            <PagerContent>
                <MudDataGridPager T="Case" InfoFormat="Showing {first_item}-{last_item} of {all_items}" />
            </PagerContent>
        </MudDataGrid>
    </div>


  @*   <MudTable Items="caseList" Dense="true" Striped="true" Hover="true" Bordered="true" Class="mt-5">
        <HeaderContent>
            <MudTh>CaseTitle</MudTh>
            <MudTh>CaseDetail</MudTh>
            <MudTh>HearingDate</MudTh>
            <MudTh>CourtLocation</MudTh>
            <MudTh>CaseNumber</MudTh>
        </HeaderContent>
        <RowTemplate>
            @if (caseList != null && caseList.Count > 0)
            {
                foreach (var caseItem in caseList)
                {
                    <MudTr>
                        <MudTd>@caseItem.CaseTitle</MudTd>
                        <MudTd>@caseItem.CaseDetail</MudTd>
                        <MudTd>@caseItem.HearingDate.ToShortDateString()</MudTd>
                        <MudTd>@caseItem.CourtLocation</MudTd>
                        <MudTd>@caseItem.CaseNumber</MudTd>
                    </MudTr>
                }
            }
            else
            {
                <MudTr>
                    <MudTd Class="text-center">No Data Found..!</MudTd>
                </MudTr>
            }
        </RowTemplate>
    </MudTable> *@

}

@code {
    private long userId { get; set; }
    private List<Case> caseList = new();
    private List<Case> searchCaseData = new();
    private Case caseData = new();
    private DateTime fromDate;
    private DateTime toDate;
    DateTime date = DateTime.Now;
    string userName = string.Empty;
    private Client clientData = new();
    private long clientId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        TitleService.CurrentPageTitle = "Cases";
        var userSessionId = await Session.GetAsync<long>("UserId");
        userId = userSessionId.Value > 0 ? userSessionId.Value : 0;
        clientData = ClientService.GetClientUsingUserId(userId);
        clientId = clientData.Id;

        GetCase(clientId);
        var userData = UserService.GetUserById(userId);
        userName = userData != null ? userData.Name : string.Empty;
        fromDate = new DateTime(date.Year, date.Month, 1);
        toDate = fromDate.AddMonths(1).AddDays(-1);
    }

    private void GetCase(long clientId)
    {
        caseList = CaseService.ListClientCases(clientId);
        searchCaseData = caseList;
    }

    private async Task AddCase(string redirectUrl)
    {
        DialogParameters dialogParameters = new DialogParameters();
        dialogParameters.Add("FormAction", FormAction.Add);

        var caseInfo = await DialogService.ShowAsync<AddEditCase>("Add Case", dialogParameters, new DialogOptions()
            {
                MaxWidth = MaxWidth.Medium,
                Position = DialogPosition.Center,
                CloseButton = true,
                FullWidth = true
            });

        if (caseInfo is not null && caseInfo.Result.Status == TaskStatus.Created)
        {
            Snackbar.Add("Case saved successfully.", Severity.Success);
            GetCase(userId);
        }
    }

    private async Task EditCase(long caseId)
    {
        DialogParameters dialogParameters = new DialogParameters();
        dialogParameters.Add("CaseId", caseId);
        dialogParameters.Add("FormAction", FormAction.Edit);

        var caseInfo = await DialogService.ShowAsync<AddEditCase>("Edit Case", dialogParameters, new DialogOptions()
            {
                MaxWidth = MaxWidth.Medium,
                Position = DialogPosition.Center,
                CloseButton = true,
                FullWidth = true
            });

        if (caseInfo is not null && caseInfo.Result.Result == DialogResult.Ok(true))
        {
            Snackbar.Add("Case saved successfully.", Severity.Success);
            GetCase(userId);
        }
    }

    private async Task PrintCaseList()
    {
        string title = string.Concat(userName, " Case details!");
        await Js.InvokeVoidAsync("printTable", "case-table", title);
    }

    protected void FilterCases()
    {
        caseList = searchCaseData
            .Where(x => x.HearingDate.Date >= fromDate && x.HearingDate.Date <= toDate)
            .ToList();
    }
}