@page "/client/lawyerList"

@using CaseTracker.Services
@using CaseTracker.Services.Interface
@using CaseTracker.Data.ContextModels

@inject TitleService TitleService
@inject ILawyerService LawyerService

<h3>Client Lawyers</h3>

@if (lawyerList == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="main-table mt-3">
        <MudDataGrid T="Lawyer" Items="lawyerList" Class="case-table" Dense="true" Hover="true" Bordered="true"
                     SortMode="SortMode.Single" Filterable="false" Hideable="false" FooterClass="d-none">
            <Columns>
                <SelectColumn T="Case" />
                <PropertyColumn CellClass="bold-cell" Property="x => x.User.Name" Sortable="false" Title="Name" />
                <PropertyColumn CellClass="bold-cell" Property="x => x.User.Email" Sortable="false" Title="Email Id" />
                <PropertyColumn CellClass="bold-cell" Property="x => x.User.MobileNo" Sortable="false" Title="Mobile No" />
                <PropertyColumn CellClass="bold-cell" Property="x => x.User.City" Sortable="false" Title="City" />
                <PropertyColumn CellClass="bold-cell" Property="x => x.Specialization" Sortable="false" Title="Specialization" />
            </Columns>
            <PagerContent>
                <MudDataGridPager T="Lawyer" InfoFormat="Showing {first_item}-{last_item} of {all_items}" />
            </PagerContent>
        </MudDataGrid>
    </div>
}


@code {
    private long userId { get; set; }
    private List<Lawyer> lawyerList = new();

    protected override void OnInitialized()
    {
        TitleService.CurrentPageTitle = "Lawyers";
        lawyerList = LawyerService.GetLawyersWithUserDetails();

        base.OnInitialized();
    }
}
