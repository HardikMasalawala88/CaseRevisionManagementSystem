@using CaseTracker.DESKTOPUI.Shared.Component
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using System.Security.Claims;
@using MudBlazor

@inject ProtectedSessionStorage Session
@inject NavigationManager NavigationManager

<div class="sms-mudnavmenu">
    <AuthorizeView Roles="Lawyer">
        <Authorized>
            <MudNavMenu Class="mt-1">
                @* <SNavMenuItem MenuName="home" Href="" Text="Home" IsActive="@IsActiveMenu("")" OnMenuItemClicked="HandleMenuItemClicked" /> *@
                <SNavMenuItem MenuName="dashboard" Href="user/dashboard" Text="Dashboard" IsActive="@IsActiveMenu("user/dashboard")" OnMenuItemClicked="HandleMenuItemClicked" />
                <SNavMenuItem MenuName="client" Href="client/clientlist" Text="Clients" IsActive="@IsActiveMenu("client/clientlist")" OnMenuItemClicked="HandleMenuItemClicked" />
                <SNavMenuItem MenuName="case" Href="case/caselist" Text="Cases" IsActive="@IsActiveMenu("case/caselist")" OnMenuItemClicked="HandleMenuItemClicked" />
                <SNavMenuItem MenuName="profile" Href="@($"user/profile/{userId}")" Text="Profile" IsActive="@IsActiveMenu("user/profile/{userId}")" OnMenuItemClicked="HandleMenuItemClicked" />
            </MudNavMenu>
        </Authorized>
    </AuthorizeView>
    <AuthorizeView Roles="Client">
        <Authorized>
            <MudNavMenu Class="mt-1">
                <SNavMenuItem MenuName="home" Href="" Text="Home" IsActive="@IsActiveMenu("")" OnMenuItemClicked="HandleMenuItemClicked" />
                <SNavMenuItem MenuName="case" Href="case/clientcases" ActiveIcon="campaign-activke" DefaultIcon="campaign-default" Text="Cases" IsActive="@IsActiveMenu("case/clientcases")" OnMenuItemClicked="HandleMenuItemClicked" />
                <SNavMenuItem MenuName="client" Href="client/lawyerList" ActiveIcon="user-active" DefaultIcon="user-default" Text="Lawyers" IsActive="@IsActiveMenu("lawyers")" OnMenuItemClicked="HandleMenuItemClicked" />
                <SNavMenuItem MenuName="profile" Href="@($"user/profile/{userId}")" ActiveIcon="diamond-active" DefaultIcon="diamond-default" Text="Assistant" IsActive="@IsActiveMenu("myprofile")" OnMenuItemClicked="HandleMenuItemClicked" />
            </MudNavMenu>
        </Authorized>
    </AuthorizeView>
    
</div>
<div class="bottom-mudnavmenu mt-auto">
    <MudNavMenu Class="mt-1">
        <MudItem Class="d-flex justify-content-center my-5 align-center" Style="padding: 2px 25px;">
            <MudItem Class="d-flex justify-start align-center">
                <MudText Class="copyright-text">@(string.Concat("©CRMS", " ", DateTime.UtcNow.Year))</MudText>
            </MudItem>
        </MudItem>
    </MudNavMenu>
</div>

@code {

    //ProtectedBrowserStorageResult<string> userData = new ProtectedBrowserStorageResult<string>();
    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;
    private bool collapseNavMenu = true;
    private long userId;
    private string ActiveMenuName = "home";

    protected override async Task OnInitializedAsync()
    {
        var userSessionId = await Session.GetAsync<long>("UserId");
        userId = userSessionId.Value > 0 ? userSessionId.Value : 0;
    }

    private async Task ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
        var user = await Session.GetAsync<string>("User");
    }

    private async Task HandleMenuItemClicked(string menuName)
    {
        // You can update the active menu item here
        await ActiveMenu(menuName);
    }

    private async Task ActiveMenu(string menuName)
    {
        ActiveMenuName = menuName;
        NavigationManager.NavigateTo("/" + menuName);
        await InvokeAsync(() => StateHasChanged());
    }

    private bool IsActiveMenu(string currentMenuName)
    {
        string url = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        return ActiveMenuName.Equals(currentMenuName, StringComparison.OrdinalIgnoreCase);
    }

    private async Task OpenClientCase()
    {
        var userSessionId = await Session.GetAsync<long>("UserId");
        userId = userSessionId.Value > 0 ? userSessionId.Value : 0;

        NavigationManager.NavigateTo($"case/clientcases/{userId}");
    }
}
