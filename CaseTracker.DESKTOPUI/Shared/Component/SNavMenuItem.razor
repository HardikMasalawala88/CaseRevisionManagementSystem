@using CaseTracker.DESKTOPUI.Shared.Common
@using CaseTracker.DESKTOPUI.Shared.Enum
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Routing
@using MudBlazor

<MudNavLink Href="@Href" Match="NavLinkMatch.All" Class="@(IsActive ? " active ":"")">
    <MudItem @onclick="OnClick">
        @if (ShowBlueDot)
        {
            <MudItem Class="d-flex justify-space-between align-center">
                <MudItem Class="d-flex justify-start align-center">
                    @if (IsActive)
                    {
                        <MudIcon Icon="@(getActiveIcon())" Color="Color.Primary" />
                        @* <CustomIcon IconName="@ActiveIcon" State="IconStateEnum.Active" /> *@
                    }
                    else
                    {
                        <MudIcon Icon="@(getDefaultIcon())" />
                        @* <CustomIcon IconName="@DefaultIcon" State="IconStateEnum.Default" /> *@
                    }
                    <span class="ml-3">@Text</span>
                </MudItem>
                <span class="blue-dot"></span>
            </MudItem>
        }
        else
        {
            <MudItem Class="d-flex justify-start">
                @if (IsActive)
                {
                    <MudIcon Icon="@(getActiveIcon())" Color="Color.Primary" />
                    @* <CustomIcon IconName="@ActiveIcon" State="IconStateEnum.Active" /> *@
                }
                else
                {
                    <MudIcon Icon="@(getDefaultIcon())" />
                    @* <CustomIcon IconName="@DefaultIcon" State="IconStateEnum.Default" /> *@
                }
                <span class="ml-3">@Text</span>
            </MudItem>
        }
    </MudItem>
</MudNavLink>

@code{
    [Parameter] public string MenuName { get; set; }
    [Parameter] public string Href { get; set; }
    [Parameter] public string ActiveIcon { get; set; }
    [Parameter] public string DefaultIcon { get; set; }
    [Parameter] public string Text { get; set; }
    [Parameter] public bool IsActive { get; set; }
    [Parameter] public bool ShowBlueDot { get; set; }
    [Parameter] public EventCallback<string> OnMenuItemClicked { get; set; }

    private async Task OnClick()
    {
        await OnMenuItemClicked.InvokeAsync(Href);
    }

    private string getActiveIcon()
    {
        string iconName = "";
        switch (MenuName)
        {
            case "home":
                iconName = Icons.Material.Filled.Home;
                break;
            case "dashboard":
                iconName = Icons.Material.Filled.CalendarMonth;
                break;
            case "case":
                iconName = Icons.Material.Filled.LibraryBooks;
                break;
            case "client":
                iconName = Icons.Material.Filled.People;
                break;
            case "profile":
                iconName = Icons.Material.Filled.Person;
                break;
            default:
                break;
        }

        return iconName;
    }

    private string getDefaultIcon()
    {
        string iconName = "";
        switch (MenuName)
        {
            case "home":
                iconName = Icons.Material.Outlined.Home;
                break;
            case "dashboard":
                iconName = Icons.Material.Outlined.CalendarMonth;
                break;
            case "case":
                iconName = Icons.Material.Outlined.LibraryBooks;
                break;
            case "client":
                iconName = Icons.Material.Outlined.People;
                break;
            case "profile":
                iconName = Icons.Material.Outlined.Person;
                break;
            default:
                break;
        }

        return iconName;

    }
}